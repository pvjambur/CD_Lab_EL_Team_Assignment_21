#!/usr/bin/env bash
# nsan-clang++ : Wrapper script to emulate -fsanitize=numerical

REPO="$(cd "$(dirname "$0")" && pwd)"
PLUGIN="$REPO/build/src/nsan/libnsan_pass.so"
RUNTIME="$REPO/build/src/runtime/libnsan_runtime.a"
COMPILER=${CXX:-clang++}

SYSROOT_ARGS=()
if [ "$(uname)" = "Darwin" ]; then
  SDK="$(xcrun --show-sdk-path 2>/dev/null || echo '')"
  if [ -n "$SDK" ]; then
    SYSROOT_ARGS=("-isysroot" "$SDK" "-nostdinc++" "-isystem" "$SDK/usr/include/c++/v1" "-isystem" "$SDK/usr/include")
  fi
fi

NEW_ARGS=()
HAS_NSAN=0

for arg in "$@"; do
  if [ "$arg" = "-fsanitize=numerical" ]; then
    HAS_NSAN=1
    NEW_ARGS+=("-fpass-plugin=$PLUGIN")
  else
    NEW_ARGS+=("$arg")
  fi
done

if [ $HAS_NSAN -eq 1 ]; then
  NEW_ARGS+=("$RUNTIME")
fi

exec $COMPILER "${SYSROOT_ARGS[@]}" "${NEW_ARGS[@]}"
